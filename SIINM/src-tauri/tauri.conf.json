{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "SIINM",
  "version": "0.1.0",
  "identifier": "com.caisesmoroleon.siinm",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "SIINM | Sistema Integral de Inventario Médico",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJEMjk5OUQ1NDAzNTYzQUIKUldTcll6VkExWmtwdlJKZ3BpK1dtRnlLYmNMdWtxa2Q4ZENUNndsTENxcnFiYWI2RVFvclhxaXUK",
      "endpoints": [
        "https://github.com/Josue789/SIINM/releases/latest/download/latest.json"
      ]
    }
  }
}
